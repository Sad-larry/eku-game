# Godot 导入系统
.godot/

# 第三方插件（不需要关注）
addons/

# 运行时日志输出
logs/

# 启停脚本（仅用于运行项目，不需要关注）
run_scripts/

# 版本控制
.git/
.gitignore
.gitattributes

# 环境配置
.env
.env.*
!.env.example
*.local

# IDE 相关
.idea/
.vscode/
*.sublime-*

# 日志和临时文件
*.log
*.tmp
*.temp
*.swp
.cache/

# Godot 导出构建产物
*.exe
*.dll
*.so
*.dylib

# 二进制资源文件
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.webp
*.svg
*.mp4
*.mp3
*.ogg
*.wav
*.ttf
*.otf
*.blend
