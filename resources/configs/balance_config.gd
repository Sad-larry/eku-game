# ==============================================================================
#   BalanceConfig.gd
#   功能：游戏平衡性配置资源，存储战斗相关的数值参数（连击窗口、伤害倍率、
#        击退力、能量恢复等），可作为独立资源文件（.tres）在编辑器中调整。
# ==============================================================================
extends Resource
class_name BalanceConfig

# ========================== 导出变量模块 ==========================
## 连击判定时间窗口（毫秒）
## 说明：允许玩家在本次攻击结束后输入下一次攻击的时间窗口，超过此时间窗口则连击中断
@export var combo_window_ms: float = 500.0

## 基础伤害倍率
## 说明：所有攻击伤害的基准倍率，实际伤害 = 基础伤害 × 此倍率 × 攻击组件设定的倍率
@export var damage_multiplier_base: float = 1.0

## 基础击退力
## 说明：受击时施加的基准击退力度，实际击退 = 基础击退力 × 技能/武器击退系数
@export var knockback_base: float = 100.0

## 每秒能量恢复数值
## 说明：角色在非攻击/受击状态下的每秒自动能量恢复量
@export var energy_regen_per_second: float = 5.0
