# ==============================================================================
#   battle_room_config.gd
#   功能：战斗房间配置，定义房间内生成的敌人种类、数量和难度缩放。
# ==============================================================================
extends Resource
class_name BattleRoomConfig

# ========================== 导出变量模块 ==========================
## 敌人条目列表（每种敌人的场景、数量、权重）
@export var enemy_entries: Array[EnemyEntry] = []
## 难度缩放系数（影响敌人属性）
@export var difficulty_scale: float = 1.0
