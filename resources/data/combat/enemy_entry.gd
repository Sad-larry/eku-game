# ==============================================================================
#   enemy_entry.gd
#   功能：敌人条目配置，定义单个敌人种类的场景、数量和权重。
# ==============================================================================
extends Resource
class_name EnemyEntry

# ========================== 导出变量模块 ==========================
## 敌人预制体场景
@export var enemy_scene: PackedScene
## 生成数量
@export var count: int = 1
## 随机选取权重（用于从多个 EnemyEntry 中按权重随机选择）
@export var weight: float = 1.0
