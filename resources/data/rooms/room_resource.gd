# ==============================================================================
#   room_resource.gd
#   功能：房间资源数据类（当前为旧版占位，建议使用 RoomConfig 替代）。
#        记录房间的波次配置和默认敌人场景。
#   注意：此文件可能已被 RoomConfig 取代，保留仅为兼容旧代码。
# ==============================================================================
extends Resource
class_name RoomResource

# ========================== 导出变量模块 ==========================
## 波次数据列表（支持多波次战斗配置）
@export var waves: Array[WaveData]

## 默认敌人场景（当房间无波次配置时，使用此场景生成敌人）
@export var default_enemy_scene: PackedScene

