# ==============================================================================
#   WaveUnitData.gd
#   功能：波次单位数据资源类，定义单个敌方单位在波次中的配置，
#        包含单位场景和随机权重，用于波次系统中的单位池配置。
# ==============================================================================
extends Resource
class_name WaveUnitData

# ========================== 导出变量模块 ==========================
## 敌方单位场景（需继承自 Enemy 或具有战斗逻辑的节点）
@export var unit_scene: PackedScene
## 随机权重（权重越高，被随机选中的概率越大）
## 权重值为浮点数，可支持相对概率计算（如 1.0、2.5、0.3 等）
@export var weight := 0.0
